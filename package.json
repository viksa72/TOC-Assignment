{
  "name": "turing-machine-simulator",
  "version": "1.0.0",
  "description": "Turing Machine Simulator — TOC Assignment",
  "scripts": {
    "build": "tsc",
    "dev:server": "cd backend/server && npx ts-node-dev --respawn --transpile-only src/index.ts",
    "dev": "concurrently \"npm run dev:server\" \"npm run build -- --watch\"",
    "setup": "npm install && cd backend/server && npm install"
  },
  "devDependencies": {
    "@vercel/node": "^3.0.0",
    "concurrently": "^8.2.2",
    "typescript": "^5.4.5"
  }
}
