{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "lib": ["ES2020", "DOM"],
    "outDir": "./public",
    "rootDir": "./public/frontend",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "noEmitOnError": true
  },
  "include": ["public/frontend/**/*"],
  "exclude": ["backend", "api", "node_modules"]
}
